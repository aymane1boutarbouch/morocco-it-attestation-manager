<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.moroccoit.attestation.controller.EmployeeController"
      spacing="20">

    <!-- TOOLBAR & SEARCH BAR -->
    <HBox styleClass="card" alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="searchField" promptText="🔍 Rechercher par Nom, CIN, Matricule, Département..." prefWidth="350" styleClass="text-field" />
        <ComboBox fx:id="filterContractCombo" prefWidth="180" styleClass="combo-box" />

        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="12">
            <Button text="➕  Nouveau Collaborateur" onAction="#handleAddEmployee" styleClass="button-accent" />
            <Button text="✏️  Modifier Fiche" onAction="#handleEditEmployee" styleClass="button-secondary" />
            <Button text="🗑️  Supprimer" onAction="#handleDeleteEmployee" styleClass="button-danger" />
        </HBox>
    </HBox>

    <!-- EMPLOYEE TABLE -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <Label text="Répertoire du Personnel &amp; Stagiaires Morocco IT" styleClass="card-title" />
        <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRegNum" text="Matricule" prefWidth="110" />
                <TableColumn fx:id="colFullName" text="Nom &amp; Prénom" prefWidth="200" />
                <TableColumn fx:id="colCin" text="N° CIN" prefWidth="110" />
                <TableColumn fx:id="colJobTitle" text="Fonction / Poste" prefWidth="220" />
                <TableColumn fx:id="colDepartment" text="Département" prefWidth="140" />
                <TableColumn fx:id="colContractType" text="Contrat" prefWidth="100" />
                <TableColumn fx:id="colHireDate" text="Date Début" prefWidth="110" />
                <TableColumn fx:id="colSalary" text="Salaire Net (DH)" prefWidth="130" />
                <TableColumn fx:id="colStatus" text="Statut" prefWidth="90" />
            </columns>
        </TableView>
    </VBox>

</VBox>
