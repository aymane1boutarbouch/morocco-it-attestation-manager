<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.moroccoit.attestation.controller.GeneratorController"
      spacing="25">

    <!-- LEFT SIDE: FORM CONTROLS & DETAILS CARD -->
    <VBox styleClass="card" spacing="20" prefWidth="420">
        <Label text="Configuration du Document" styleClass="card-title" />

        <!-- Person Selector -->
        <VBox spacing="6">
            <Label text="Sélectionnez le Bénéficiaire (Employé / Stagiaire) :" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="employeeCombo" prefWidth="380" styleClass="combo-box" />
        </VBox>

        <!-- Selected Employee Summary Box -->
        <VBox spacing="6" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
            <Label fx:id="empNameLabel" text="Nom &amp; Prénom" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #0F172A;" />
            <HBox spacing="15">
                <Label fx:id="empCinLabel" text="CIN: AB123456" style="-fx-font-size: 11; -fx-text-fill: #64748B;" />
                <Label fx:id="empContractLabel" text="Contrat: CDI" style="-fx-font-size: 11; -fx-text-fill: #D97706; -fx-font-weight: bold;" />
            </HBox>
            <HBox spacing="15">
                <Label fx:id="empJobLabel" text="Poste: Comptable Senior" style="-fx-font-size: 11; -fx-text-fill: #475569;" />
                <Label fx:id="empDeptLabel" text="Dépt: Comptabilité" style="-fx-font-size: 11; -fx-text-fill: #475569;" />
            </HBox>
        </VBox>

        <!-- Document Type Selector -->
        <VBox spacing="6">
            <Label text="Type d'Attestation Officielle :" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="docTypeCombo" prefWidth="380" styleClass="combo-box" />
        </VBox>

        <!-- Reference Number (Auto-generated) -->
        <VBox spacing="6">
            <Label text="Numéro de Référence Officiel (Auto) :" style="-fx-font-weight: bold;" />
            <TextField fx:id="refNumField" prefWidth="380" styleClass="text-field" />
        </VBox>

        <!-- Purpose / Destination -->
        <VBox spacing="6">
            <Label text="Motif / Destination (Optionnel) :" style="-fx-font-weight: bold;" />
            <TextField fx:id="purposeField" promptText="ex: Pour servir et valoir ce que de droit, Dossier Visa..." prefWidth="380" styleClass="text-field" />
        </VBox>

        <!-- Actions -->
        <VBox spacing="10" VBox.vgrow="ALWAYS" alignment="BOTTOM_LEFT">
            <Button text="⚡  Aperçu en Temps Réel" onAction="#refreshPreview" styleClass="button-secondary" prefWidth="380" />
            <Button text="📄  Générer &amp; Sauvegarder le PDF" onAction="#handleGenerateAndSave" styleClass="button-accent" prefWidth="380" style="-fx-font-size: 14; -fx-padding: 12;" />
            <Button text="📝  Exporter en Word (.docx)" onAction="#handleExportDocx" styleClass="button-primary" prefWidth="380" />
        </VBox>
    </VBox>

    <!-- RIGHT SIDE: LIVE PDF PREVIEW PANEL -->
    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="15">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Aperçu du Document PDF (Temps Réel)" styleClass="card-title" HBox.hgrow="ALWAYS" />
            <Label text="Qualité Vectorielle Haute Définition avec QR Code" style="-fx-font-size: 11; -fx-text-fill: #10B981; -fx-font-weight: bold;" />
        </HBox>

        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: #F1F5F9; -fx-padding: 15;">
            <VBox fx:id="previewContainer" alignment="CENTER" style="-fx-background-color: transparent;">
                <ImageView fx:id="pdfPreviewImageView" preserveRatio="true"
                           style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 4);" />
            </VBox>
        </ScrollPane>
    </VBox>

</HBox>
